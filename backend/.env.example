# Copie para .env e ajuste.

PORT=3333

# Banco MySQL 8 / MariaDB (XAMPP usa root sem senha, porta 3306)
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_NAME=didaskaros

# Troque por um texto longo e aleatório
JWT_SECRET=troque-este-segredo

# Chave da API da Claude (https://console.anthropic.com) — usada para gerar grades
ANTHROPIC_API_KEY=
# Modelo e esforço usados na geração
CLAUDE_MODEL=claude-opus-5-5
CLAUDE_EFFORT=high
